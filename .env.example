# PayPal (sandbox only) - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Channel3 product search - https://docs.trychannel3.com (promo: PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# AI provider: anthropic | google (switch by changing only these three)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Ed25519 signing key (PKCS#8 PEM, base64). Generated on first run if empty.
SIGNING_PRIVATE_KEY=

# Database: local SQLite file (file:./covenant.db) OR Turso Cloud SQLite (libsql://... for Vercel)
DATABASE_URL=file:./covenant.db
DATABASE_AUTH_TOKEN=
APP_BASE_URL=http://localhost:3000
